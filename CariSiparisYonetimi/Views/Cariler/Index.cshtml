@model List<CariSiparisYonetimi.Models.Cari>

@{
    ViewData["Title"] = "Cariler";
}

<h1>Cariler</h1>

<a asp-action="Ekle" class="btn btn-primary mb-3">
    Yeni Cari Ekle
</a>

@if (TempData["Basari"] is string basariMesaji)
{
    <div class="alert alert-success" role="alert">
        @basariMesaji
    </div>
}

@if (TempData["Hata"] is string hataMesaji)
{
    <div class="alert alert-danger" role="alert">
        @hataMesaji
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz cari kaydı bulunmuyor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>Cari Kodu</th>
                    <th>Cari Adı</th>
                    <th>Telefon</th>
                    <th>E-posta</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var cari in Model)
                {
                    var logoVar = !string.IsNullOrWhiteSpace(cari.LogoYolu);

                    <tr>
                        <td>
                            @if (logoVar)
                            {
                                <img src="@cari.LogoYolu"
                                     alt="@(cari.CariAdi + " logosu")"
                                     class="img-thumbnail"
                                     style="width: 64px; height: 64px; object-fit: contain;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <span class="text-muted">Logo yok</span>
                            }
                        </td>

                        <td>@cari.CariKodu</td>
                        <td>@cari.CariAdi</td>
                        <td>@cari.Telefon</td>
                        <td>@cari.Eposta</td>

                        <td>
                            <span class="badge @(cari.AktifMi ? "bg-success" : "bg-secondary")">
                                @(cari.AktifMi ? "Aktif" : "Pasif")
                            </span>
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-2">

                                <a asp-action="Duzenle"
                                   asp-route-id="@cari.Id"
                                   class="btn btn-sm btn-warning">
                                    Düzenle
                                </a>

                                <a asp-action="LogoYukle"
                                   asp-route-id="@cari.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    @(logoVar ? "Logoyu Değiştir" : "Logo Yükle")
                                </a>

                                @if (logoVar)
                                {
                                    <form asp-controller="Cariler"
                                          asp-action="LogoSil"
                                          asp-route-id="@cari.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu carinin logosunu silmek istiyor musunuz?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Logoyu Sil
                                        </button>
                                    </form>
                                }

                                @if (cari.AktifMi)
                                {
                                    <form asp-controller="Cariler"
                                          asp-action="PasifeAl"
                                          asp-route-id="@cari.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu cariyi pasife almak istiyor musunuz?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Pasife Al
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Cariler"
                                          asp-action="AktifeAl"
                                          asp-route-id="@cari.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu cariyi aktife almak istiyor musunuz?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Aktife Al
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}